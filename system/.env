# user variables
export PROJECTS="$HOME/dev/projects"
export DOCS="$HOME/docs"
export DOWNLOADS="$HOME/downloads"
export IMAGES="$HOME/images"
export MUSICS="$HOME/musics"
export VIDEOS="$HOME/videos"
export SCRIPTS="$HOME/.scripts"

# system variables
export TERMINAL=alacritty
export VISUAL=nvim

# config files
export I3_CFG_FILE="$HOME/.config/i3/config"
export NVIM_CFG_FILE="$HOME/.config/nvim/init.lua"
export ROFI_CFG_FILE="$HOME/.config/rofi/config.rasi"
export TMUX_CFG_FILE="$HOME/.tmux.conf"
export ALACRITTY_CFG_FILE="$HOME/.config/alacritty/alacritty.toml"
export QUTEBROWSER_CFG_FILE="$HOME/.config/qutebrowser/config.py"
export NEWSBOAT_CFG_FILE="$HOME/.newsboat/config"
export RANGER_CFG_FILE="$HOME/.config/qutebrowser/rc.conf"
